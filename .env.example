# Modal Configuration
# Your Modal token ID - get this from https://modal.com/settings
MODAL_TOKEN_ID=your_modal_token_id_here

# Your Modal token secret - get this from https://modal.com/settings
MODAL_TOKEN_SECRET=your_modal_token_secret_here

# Modal environment (usually 'main' for production)
MODAL_ENVIRONMENT=main

# API Authentication Token
# This token is used to authenticate HTTP requests to the Modal web endpoints.
# You MUST create a Modal secret named "AUTH_TOKEN" with this value:
#   modal secret create AUTH_TOKEN AUTH_TOKEN=your_secure_token_here
# Or via the Modal dashboard: https://modal.com/secrets
AUTH_TOKEN=your_secure_token_here

# Modal app name (should match the app name in modal_whisper_transcribe.py)
MODAL_APP_NAME=modal-whisper-transcribe

# YouTube Modal app name (should match the app name in modal_youtube_transcribe.py)
YOUTUBE_MODAL_APP_NAME=modal-youtube-transcribe

# WhisperX Configuration
# GPU type for Modal deployment (default: T4)
WHISPERX_GPU=T4
# WhisperX model name (default: large-v2)
WHISPERX_MODEL=large-v2

# Server Configuration
# Host to bind the server to (0.0.0.0 for all interfaces, 127.0.0.1 for localhost only)
HOST=0.0.0.0

# Port to run the server on
PORT=8000

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Optional: Maximum file size for uploads (in bytes)
# MAX_FILE_SIZE=25000000

# Optional: Allowed audio file extensions (comma-separated)
# ALLOWED_EXTENSIONS=mp3,wav,m4a,flac,ogg,webm,mp4,avi,mov